# ============================================================
# DEPLOYMENT
# ============================================================
# Kopieren nach .env.docker und Werte eintragen (wird von docker-compose.yml geladen)

# IP-Adresse oder Domain des Servers (z.B. 188.34.153.145 oder myapp.com)
DOMAIN=example.com

# SSL via Let's Encrypt:
#   - "off"            → kein SSL (immer bei IP-Adressen!)
#   - "deine@email.de" → automatisches SSL-Zertifikat (nur mit echter Domain!)
ACME_EMAIL=off

# ============================================================
# LARAVEL APP
# ============================================================

APP_NAME="Alpha Collection"
APP_ENV=production
APP_DEBUG=false

# Generieren mit: docker compose run --rm backend php artisan key:generate --show
APP_KEY=

# Bei SSL: https:// statt http://
APP_URL=https://example.com

# ============================================================
# DATENBANK (SQLite)
# ============================================================

DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite

# ============================================================
# SESSION / CACHE / QUEUE
# ============================================================

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ============================================================
# CORS & SANCTUM
# ============================================================

# Gleicher Wert wie APP_URL
FRONTEND_URL=https://example.com

# Nur die Domain/IP ohne Protokoll
SANCTUM_STATEFUL_DOMAINS=example.com,www.example.com
SESSION_DOMAIN=.example.com

# ============================================================
# MAIL (optional)
# ============================================================

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Alpha Collection"
