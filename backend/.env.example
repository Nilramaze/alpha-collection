APP_NAME="Alpha Collection"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

# SQLite: Datei backend/database/database.sqlite
DB_CONNECTION=sqlite

SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DRIVER=database

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Lokal: Mails landen in storage/logs/laravel.log
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@alpha-collection.de
MAIL_FROM_NAME="Alpha Collection"
